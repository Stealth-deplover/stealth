COMPOSE_PROJECT_NAME=stealth-v025-upgrade
STEALTH_API_IMAGE=stealth-api:v025-operator-override
STEALTH_SETUP_IMAGE=ghcr.io/stealth-deplover/stealth-setup:v0.2.5
STEALTH_WORKER_IMAGE=ghcr.io/stealth-deplover/stealth-worker:v0.2.5
STEALTH_MIGRATE_IMAGE=ghcr.io/stealth-deplover/stealth-migrate:v0.2.5
STEALTH_CONSOLE_IMAGE=ghcr.io/stealth-deplover/stealth-console:v0.2.5
POSTGRES_DB=stealth
POSTGRES_USER=stealth
POSTGRES_PASSWORD=v025-test-postgres-secret
DATABASE_URL=postgres://stealth:v025-test-postgres-secret@postgres:5432/stealth?sslmode=disable
REDIS_PASSWORD=v025-test-redis-secret
REDIS_URL=redis://:v025-test-redis-secret@redis:6379/0
FUNCTIONS_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BOOTSTRAP_CLI_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
GITHUB_APP_CLIENT_ID=Iv1.v025-test-client
PUBLIC_APP_URL=http://127.0.0.1:13000
COOKIE_SECURE=false
CONSOLE_CORS_ORIGINS=
TRUSTED_PROXY_CIDRS=172.30.0.0/24
STEALTH_NETWORK_SUBNET=172.30.0.0/24
STEALTH_NETWORK_NAME=stealth_v025_upgrade_network
DOCKER_GID=999
METRICS_TOKEN=v025-test-metrics-token
PROJECT_OPERATION_RATE_LIMIT=120
PROJECT_OPERATION_RATE_WINDOW=1m
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE=50MiB
STORAGE_DEFAULT_QUOTA_BYTES=1GiB
FUNCTIONS_RUNNER_ENABLED=true
FUNCTIONS_WORKER_ID=stealth-worker
FUNCTIONS_RUNNER_STAGING_VOLUME=stealth_v025_upgrade_staging
FUNCTIONS_RUNNER_HELPER_IMAGE=alpine:3.22
FUNCTIONS_RUNNER_NODE_IMAGE=node:22-alpine
FUNCTIONS_RUNNER_PYTHON_IMAGE=python:3.13-alpine
FUNCTIONS_RUNNER_GO_IMAGE=golang:1.24-alpine
AGENT_RUNNER_ENABLED=false
PROXY_HTTP_BIND=127.0.0.1
PROXY_HTTP_PORT=8080
API_HOST_PORT=18080
CONSOLE_HOST_PORT=13000
SETUP_API_HOST_PORT=18081
SETUP_CONSOLE_HOST_PORT=13001
SETUP_PROXY_HTTP_PORT=8081
SETUP_MODE=false
