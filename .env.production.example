# Copy to .env.production and replace every CHANGE_ME value.
# Keep API, worker, migrate, Console, Collector, and telemetry proxy on the
# same release tag.
STEALTH_API_IMAGE=ghcr.io/stealth-deplover/stealth-api:v0.2.2
STEALTH_SETUP_IMAGE=ghcr.io/stealth-deplover/stealth-setup:v0.2.2
STEALTH_WORKER_IMAGE=ghcr.io/stealth-deplover/stealth-worker:v0.2.2
STEALTH_MIGRATE_IMAGE=ghcr.io/stealth-deplover/stealth-migrate:v0.2.2
STEALTH_CONSOLE_IMAGE=ghcr.io/stealth-deplover/stealth-console:v0.2.2
STEALTH_TELEMETRY_DOCKER_PROXY_IMAGE=ghcr.io/stealth-deplover/stealth-telemetry-docker-proxy:v0.2.2

# Core / PostgreSQL. Hex passwords avoid URL escaping in DATABASE_URL.
POSTGRES_DB=stealth
POSTGRES_USER=stealth
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
DATABASE_MAX_CONNS=16
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Redis is used for distributed rate limits. It is intentionally not a
# durable queue in the current architecture, so the Compose baseline keeps
# it disposable and authenticated.
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# Optional external infrastructure overrides. Leave these unset for the
# bundled PostgreSQL and Redis services. The browser setup wizard tests an
# external URL before it writes the final production configuration.
# DATABASE_URL=postgresql://user:password@db.example.com:5432/stealth?sslmode=require
# REDIS_URL=rediss://:password@redis.example.com:6379/0

# Auth / public URL. Generate the function key with:
#   openssl rand -base64 32
FUNCTIONS_SECRET_KEY=CHANGE_ME_base64_32_byte_key
# Dedicated proof key for the local CLI's temporary first-owner onboarding
# session. Generate with: openssl rand -base64 32
BOOTSTRAP_CLI_KEY=CHANGE_ME_base64_32_byte_cli_key
STEALTH_SETUP_HANDOFF_FILE=/var/lib/stealth/storage/.setup-handoff.enc
# GitHub App Client ID for an existing/manual production App. Fresh browser
# setup creates the App through the Manifest flow and fills this value from the
# server-side callback; it does not require GitHub Device Flow to be enabled.
GITHUB_APP_CLIENT_ID=CHANGE_ME_github_app_client_id
PUBLIC_APP_URL=https://console.example.com
COOKIE_SECURE=true
CONSOLE_CORS_ORIGINS=

# Trust only the private proxy network that reaches the Go API. Add every
# trusted forwarding hop's CIDR when a Cloudflare/LB layer precedes Nginx.
TRUSTED_PROXY_CIDRS=172.30.0.0/24
STEALTH_NETWORK_SUBNET=172.30.0.0/24
STEALTH_TELEMETRY_INGEST_NETWORK_NAME=stealth_telemetry_ingest
DOCKER_GID=999
# The telemetry Docker proxy uses this group only to perform its allowlisted
# read-only Docker API requests. It is not published to the host.

# Protected metrics are optional but strongly recommended for an operator.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME_metrics_token

# Observability storage. ClickHouse and the Collector are private Compose
# services; no ClickHouse or OTLP port is published on the host.
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.6.5
CLICKHOUSE_DATABASE=stealth_telemetry
CLICKHOUSE_USER=stealth
CLICKHOUSE_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
CLICKHOUSE_VOLUME_NAME=stealth_clickhouse_data
CLICKHOUSE_MEMORY_LIMIT=1g
OTEL_COLLECTOR_IMAGE=ghcr.io/stealth-deplover/stealth-otel-collector:v0.2.2
OTEL_HOST_COLLECTOR_IMAGE=ghcr.io/stealth-deplover/stealth-otel-collector:v0.2.2
OTEL_DOCKER_COLLECTOR_IMAGE=ghcr.io/stealth-deplover/stealth-otel-collector:v0.2.2
OTEL_DOCKER_LOGS_COLLECTOR_IMAGE=ghcr.io/stealth-deplover/stealth-otel-docker-logs:v0.2.2
OTEL_COLLECTOR_HEALTH_URL=http://otel-collector:13133
OTEL_COLLECTOR_MEMORY_LIMIT=512m
OTEL_HOST_COLLECTOR_MEMORY_LIMIT=256m
OTEL_DOCKER_COLLECTOR_MEMORY_LIMIT=256m
OTEL_DOCKER_LOGS_COLLECTOR_MEMORY_LIMIT=256m
OTEL_DOCKER_PROXY_MEMORY_LIMIT=64m
OTELCOL_VOLUME_NAME=stealth_otelcol_state
OTEL_DOCKER_LOGS_VOLUME_NAME=stealth_otel_docker_logs_state
TELEMETRY_MAX_QUERY_DURATION=10s
TELEMETRY_MAX_QUERY_RANGE=720h
TELEMETRY_MAX_QUERY_ROWS=1000
TELEMETRY_RETENTION=720h
OTEL_TRACES_SAMPLER_ARG=0.1

# Platform safety limits. These are not billing tiers.
PROJECT_OPERATION_RATE_LIMIT=120
PROJECT_OPERATION_RATE_WINDOW=1m
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m

# Local persistent storage is the portable baseline. For production object
# storage, set STORAGE_DRIVER=s3 and provide all STORAGE_S3_* credentials.
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE=50MiB
STORAGE_DEFAULT_QUOTA_BYTES=1GiB
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=stealth
# STORAGE_S3_ACCESS_KEY=CHANGE_ME
# STORAGE_S3_SECRET_KEY=CHANGE_ME
# STORAGE_S3_USE_SSL=true
# STORAGE_S3_PATH_STYLE=true
# STORAGE_S3_PREFIX=stealth

# Worker / function runner. The worker mounts the host Docker socket because
# the existing isolated runner launches short-lived build/execution containers.
FUNCTIONS_RUNNER_ENABLED=true
FUNCTIONS_WORKER_ID=stealth-worker
FUNCTIONS_RUNNER_STAGING_VOLUME=stealth_function_runner_staging
FUNCTIONS_RUNNER_HELPER_IMAGE=alpine:3.22
FUNCTIONS_RUNNER_NODE_IMAGE=node:22-alpine
FUNCTIONS_RUNNER_PYTHON_IMAGE=python:3.13-alpine
FUNCTIONS_RUNNER_GO_IMAGE=golang:1.24-alpine
AGENT_RUNNER_ENABLED=false

# Bind the proxy publicly only after TLS termination is configured. The
# default host ports keep direct API/Console probes on loopback.
# Keep plain HTTP loopback-only when TLS terminates on the same host. If a
# separate trusted LB terminates TLS, bind this explicitly to its private
# network instead of exposing the port directly to the Internet.
PROXY_HTTP_BIND=127.0.0.1
PROXY_HTTP_PORT=8080
API_HOST_PORT=18080
CONSOLE_HOST_PORT=13000

# Named Cloudflare Tunnel support. The setup wizard writes this file with mode
# 0600 after the tunnel token has been retrieved server-side. Cloudflare mode
# does not require host ports 80 or 443.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.0
# CLOUDFLARE_TUNNEL_TOKEN_FILE=./state/cloudflare-tunnel-token
