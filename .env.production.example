# Copy to .env.production and replace every CHANGE_ME value.
# Keep API, worker, migrate, and Console on the same release tag.
STEALTH_API_IMAGE=ghcr.io/stealth-deplover/stealth-api:v0.2.1
STEALTH_WORKER_IMAGE=ghcr.io/stealth-deplover/stealth-worker:v0.2.1
STEALTH_MIGRATE_IMAGE=ghcr.io/stealth-deplover/stealth-migrate:v0.2.1
STEALTH_CONSOLE_IMAGE=ghcr.io/stealth-deplover/stealth-console:v0.2.1

# Core / PostgreSQL. Hex passwords avoid URL escaping in DATABASE_URL.
POSTGRES_DB=stealth
POSTGRES_USER=stealth
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
DATABASE_MAX_CONNS=16
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# Redis is used for distributed rate limits. It is intentionally not a
# durable queue in the current architecture, so the Compose baseline keeps
# it disposable and authenticated.
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# Auth / public URL. Generate the function key with:
#   openssl rand -base64 32
FUNCTIONS_SECRET_KEY=CHANGE_ME_base64_32_byte_key
# Dedicated proof key for the local CLI's temporary first-owner onboarding
# session. Generate with: openssl rand -base64 32
BOOTSTRAP_CLI_KEY=CHANGE_ME_base64_32_byte_cli_key
# GitHub App Client ID used by the first-owner Device Flow. Enable Device Flow
# in the GitHub App; no TryCloudflare callback URL is required.
GITHUB_APP_CLIENT_ID=CHANGE_ME_github_app_client_id
PUBLIC_APP_URL=https://console.example.com
COOKIE_SECURE=true
CONSOLE_CORS_ORIGINS=

# Trust only the private proxy network that reaches the Go API. Add every
# trusted forwarding hop's CIDR when a Cloudflare/LB layer precedes Nginx.
TRUSTED_PROXY_CIDRS=172.30.0.0/24
STEALTH_NETWORK_SUBNET=172.30.0.0/24
DOCKER_GID=999

# Protected metrics are optional but strongly recommended for an operator.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=CHANGE_ME_metrics_token

# Platform safety limits. These are not billing tiers.
PROJECT_OPERATION_RATE_LIMIT=120
PROJECT_OPERATION_RATE_WINDOW=1m
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m

# Local persistent storage is the portable baseline. For production object
# storage, set STORAGE_DRIVER=s3 and provide all STORAGE_S3_* credentials.
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE=50MiB
STORAGE_DEFAULT_QUOTA_BYTES=1GiB
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=stealth
# STORAGE_S3_ACCESS_KEY=CHANGE_ME
# STORAGE_S3_SECRET_KEY=CHANGE_ME
# STORAGE_S3_USE_SSL=true
# STORAGE_S3_PATH_STYLE=true
# STORAGE_S3_PREFIX=stealth

# Worker / function runner. The worker mounts the host Docker socket because
# the existing isolated runner launches short-lived build/execution containers.
FUNCTIONS_RUNNER_ENABLED=true
FUNCTIONS_WORKER_ID=stealth-worker
FUNCTIONS_RUNNER_STAGING_VOLUME=stealth_function_runner_staging
FUNCTIONS_RUNNER_HELPER_IMAGE=alpine:3.22
FUNCTIONS_RUNNER_NODE_IMAGE=node:22-alpine
FUNCTIONS_RUNNER_PYTHON_IMAGE=python:3.13-alpine
FUNCTIONS_RUNNER_GO_IMAGE=golang:1.24-alpine
AGENT_RUNNER_ENABLED=false

# Bind the proxy publicly only after TLS termination is configured. The
# default host ports keep direct API/Console probes on loopback.
# Keep plain HTTP loopback-only when TLS terminates on the same host. If a
# separate trusted LB terminates TLS, bind this explicitly to its private
# network instead of exposing the port directly to the Internet.
PROXY_HTTP_BIND=127.0.0.1
PROXY_HTTP_PORT=8080
API_HOST_PORT=18080
CONSOLE_HOST_PORT=13000
