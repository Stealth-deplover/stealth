# PostgreSQL connection (migrations apply automatically on API start)
DATABASE_URL=postgres://stealth:postgres@127.0.0.1:5432/stealth?sslmode=disable
# Bounded PostgreSQL pool settings
DATABASE_MAX_CONNS=16
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
# Redis for rate limiting and worker queues
REDIS_URL=redis://127.0.0.1:6379/0
# 32-byte key, Base64 encoded (openssl rand -base64 32)
FUNCTIONS_SECRET_KEY=
# Per-project, per-actor protection for uploads, executions, queued runs,
# backups, and message sends. This is a safety limit, not a billing tier.
PROJECT_OPERATION_RATE_LIMIT=120
PROJECT_OPERATION_RATE_WINDOW=1m
HTTP_ADDR=:8080
# Leave empty to disable the metrics endpoint. If enabled, keep it on a
# private network and require this token in X-Metrics-Token.
METRICS_TOKEN=
PUBLIC_APP_URL=http://localhost:3000
# CONSOLE_CORS_ORIGINS=https://console.example.com
